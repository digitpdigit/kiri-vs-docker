# Fake credentials only. Copy to .env if you need a local override.
POSTGRES_USER=app
POSTGRES_PASSWORD=app-fake-password
POSTGRES_DB=appdb
DATABASE_URL=postgres://app:app-fake-password@postgres:5432/appdb?sslmode=disable
REDIS_ADDR=redis:6379
APP_VERSION=dev
APP_MEMORY=256M
APP_CPUS=1.0
POSTGRES_MEMORY=512M
REDIS_MEMORY=128M
